# ============================================================
# LLM Wiki Skills 环境变量模板
#
# 复制为 .env 后填写。真实 .env 已被 .gitignore 排除，绝不会上传。
# 系统环境变量优先；未设置时才会读取本项目 .env。
# ============================================================

# 详细说明与安全规则：docs/credentials/README.md

# ===== GitHub（github-stars-sync / version-tracker / auto-github-star）=====
# 获取步骤：docs/credentials/github-token.md
# 快捷入口：https://github.com/settings/tokens
# 经典 Token：勾选 public_repo（只看/操作公开仓库）
# 细粒度 Token：至少授予 Public repositories 读取 + Starring 读写
GITHUB_TOKEN=

# 留空则自动调用 GET /user 获取当前账号；不要填占位符
GITHUB_USERNAME=

# 可选：GitHub 需要代理时填写，例如 http://127.0.0.1:7890
GITHUB_PROXY=

# 可选：报告与快照输出目录，默认 ./output
OUTPUT_DIR=./output

# ===== Cloudflare Browser Rendering（cf-browser-render）=====
# 获取步骤：docs/credentials/cloudflare-browser-rendering.md
# 快捷入口：Cloudflare Dashboard → My Profile → API Tokens
# Token 权限：Account > Browser Rendering > Edit
CF_BROWSER_RENDERING_TOKEN=

# Dashboard 右侧栏的 Account ID
CF_ACCOUNT_ID=

# 重要：Cloudflare API 在部分网络（尤其国内/受限出口 IP）需要代理 IP。
# 只支持 HTTP/HTTPS 代理；SOCKS5 请先在客户端开启本地 HTTP 混合端口。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ===== 高级 =====
# 指定另一个 .env 路径（所有脚本也支持 --env-file）
# SKILL_ENV_FILE=/absolute/path/to/.env
